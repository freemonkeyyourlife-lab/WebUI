# K.I.T.T. Local-First Environment Configuration
PORT=3005
NODE_ENV=development

# Security and Mode
KITT_MODE=local
KITT_ALLOW_EXTERNAL=false
KITT_SHARE_LEVEL=none
KITT_API_KEY=

# CORS Configuration (optional, strictly OFF by default for local loopback security)
ENABLE_CORS=false

# Voice and Consent
VOICE_REQUIRE_CONSENT=true
VOICE_SAMPLE_DIR=../voice/samples
VOICE_JOB_DIR=../voice/jobs

# Personal MI Engine Paths
MI_USERS_DIR=../mi/users
MI_MEMORY_DIR=../mi/memory
MI_REGISTRY_DIR=../mi/registry_out
MI_TRANSCRIPTS_DIR=../mi/transcripts

# Game Module (FREE MONKEYS GO!)
GAME_LOCAL_ONLY=true
